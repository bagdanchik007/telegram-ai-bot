# =============================================================
#  Beispiel-Konfiguration für den Telegram-KI-Bot
#
#  Kopieren:   cp .env.example .env
#  Laden:      set -a; source .env; set +a
#  (Der Bot liest ausschließlich Umgebungsvariablen – er parst
#   die .env-Datei NICHT selbst. Die .env ist in .gitignore.)
# =============================================================

# --- Pflicht -------------------------------------------------
# Token von @BotFather auf Telegram
TELEGRAM_BOT_TOKEN=
# API-Key von https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Optional (Anthropic) ------------------------------------
# Modell-Name; Standard: claude-sonnet-5-5
# CLAUDE_MODEL=claude-sonnet-5-5

# --- Optional (allgemein) ------------------------------------
# Maximale Länge der KI-Antwort in Tokens (Standard: 1024)
# MAX_TOKENS=1024
# System-Prompt (Standard: freundlicher deutschsprachiger Assistent)
# SYSTEM_PROMPT=Du bist ein hilfreicher Assistent. Antworte knapp.

# --- Optional: OpenAI-kompatible API statt Anthropic ---------
# Funktioniert auch mit Servern wie Ollama, vLLM, LM Studio, OpenRouter ...
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
